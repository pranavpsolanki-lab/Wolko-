# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Outbound PSTN Mobile Phone Call Providers (Optional - configure any one in AI Studio Secrets for real SIM phone calls):
# 1. Twilio Programmable Voice (for real cellular phone calls with TwiML barge-in + Gemini Hinglish TTS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# 2. Vapi.ai Outbound Phone Call API
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""

# 3. Bland.ai Outbound Phone Call API
BLAND_API_KEY=""

# Optional Google Apps Script Web App URL for backend Google Sheets auto-sync
GOOGLE_SHEETS_WEBHOOK_URL=""

# Optional GitHub Repository (e.g. "username/wolko-studio") and Personal Access Token for direct CLI push
GITHUB_REPO=""
GITHUB_TOKEN=""

