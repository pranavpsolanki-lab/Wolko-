# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Automated Telegram Order Dispatch (Backend Bot Automation)
# Step 1: Create a bot via @BotFather on Telegram and paste the token inTELEGRAM_BOT_TOKEN
# Step 2: Open your bot on Telegram and tap "Start" (or optionally set TELEGRAM_CHAT_ID)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Google Apps Script Web App URL for backend Google Sheets auto-sync
GOOGLE_SHEETS_WEBHOOK_URL=""

# Optional Webhook URL
WHATSAPP_WEBHOOK_URL=""
NTFY_WHATSAPP_TOPIC="wolko_orders_8591542015"
