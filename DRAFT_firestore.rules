rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email is string &&
          request.auth.token.email.size() <= 200 &&
          request.auth.token.email == 'krishprakashsolanki@gmail.com')
      );
    }

    function isValidCustomerProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'phone',
          'address',
          'landmark',
          'city',
          'state',
          'pincode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'phone',
          'address',
          'landmark',
          'city',
          'state',
          'pincode',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.phone is string &&
        data.phone.size() >= 5 &&
        data.phone.size() <= 30 &&
        data.address is string &&
        data.address.size() >= 1 &&
        data.address.size() <= 500 &&
        data.landmark is string &&
        data.landmark.size() >= 0 &&
        data.landmark.size() <= 200 &&
        data.city is string &&
        data.city.size() >= 1 &&
        data.city.size() <= 100 &&
        data.state is string &&
        data.state.size() >= 1 &&
        data.state.size() <= 100 &&
        data.pincode is string &&
        data.pincode.size() >= 4 &&
        data.pincode.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderId',
          'userId',
          'customerName',
          'phone',
          'email',
          'address',
          'landmark',
          'city',
          'state',
          'pincode',
          'deliveryAddress',
          'deliveryNotes',
          'productsSummary',
          'totalAmount',
          'paymentMethod',
          'whatsappSentTo',
          'orderStatus',
          'aiCallStatus',
          'voiceResponse',
          'timestamp',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderId',
          'userId',
          'customerName',
          'phone',
          'email',
          'address',
          'landmark',
          'city',
          'state',
          'pincode',
          'deliveryAddress',
          'deliveryNotes',
          'productsSummary',
          'totalAmount',
          'paymentMethod',
          'whatsappSentTo',
          'orderStatus',
          'aiCallStatus',
          'voiceResponse',
          'timestamp',
          'createdAt',
          'updatedAt'
        ]) &&
        data.orderId is string &&
        data.orderId.size() >= 3 &&
        data.orderId.size() <= 128 &&
        data.orderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string &&
        data.userId.size() >= 1 &&
        data.userId.size() <= 128 &&
        data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId == request.auth.uid &&
        data.customerName is string &&
        data.customerName.size() >= 1 &&
        data.customerName.size() <= 120 &&
        data.phone is string &&
        data.phone.size() >= 5 &&
        data.phone.size() <= 30 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 200 &&
        data.address is string &&
        data.address.size() >= 1 &&
        data.address.size() <= 500 &&
        data.landmark is string &&
        data.landmark.size() >= 0 &&
        data.landmark.size() <= 200 &&
        data.city is string &&
        data.city.size() >= 1 &&
        data.city.size() <= 100 &&
        data.state is string &&
        data.state.size() >= 1 &&
        data.state.size() <= 100 &&
        data.pincode is string &&
        data.pincode.size() >= 4 &&
        data.pincode.size() <= 20 &&
        data.deliveryAddress is string &&
        data.deliveryAddress.size() >= 5 &&
        data.deliveryAddress.size() <= 800 &&
        data.deliveryNotes is string &&
        data.deliveryNotes.size() >= 0 &&
        data.deliveryNotes.size() <= 400 &&
        data.productsSummary is string &&
        data.productsSummary.size() >= 1 &&
        data.productsSummary.size() <= 1500 &&
        data.totalAmount is string &&
        data.totalAmount.size() >= 1 &&
        data.totalAmount.size() <= 40 &&
        data.paymentMethod is string &&
        data.paymentMethod.size() >= 2 &&
        data.paymentMethod.size() <= 40 &&
        (data.paymentMethod == 'UPI' || data.paymentMethod == 'COD') &&
        data.whatsappSentTo is string &&
        data.whatsappSentTo.size() >= 10 &&
        data.whatsappSentTo.size() <= 30 &&
        data.orderStatus is string &&
        data.orderStatus.size() >= 1 &&
        data.orderStatus.size() <= 60 &&
        data.aiCallStatus is string &&
        data.aiCallStatus.size() >= 1 &&
        data.aiCallStatus.size() <= 100 &&
        data.voiceResponse is string &&
        data.voiceResponse.size() >= 1 &&
        data.voiceResponse.size() <= 500 &&
        data.timestamp is string &&
        data.timestamp.size() >= 1 &&
        data.timestamp.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /customers/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) && (customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || (request.auth.token.email is string && request.auth.token.email.size() <= 200 && request.auth.token.email == 'krishprakashsolanki@gmail.com'));
      allow create: if isSignedIn() &&
        isValidId(customerId) &&
        customerId == request.auth.uid &&
        isValidCustomerProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if (
        isSignedIn() &&
        isValidCustomerProfile(incoming()) &&
        isValidId(customerId) &&
        customerId == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'email',
            'displayName',
            'phone',
            'address',
            'landmark',
            'city',
            'state',
            'pincode',
            'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        (request.auth.token.email is string &&
          request.auth.token.email.size() <= 200 &&
          request.auth.token.email == 'krishprakashsolanki@gmail.com')
      );
      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().orderId == orderId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/customers/$(incoming().userId));
      allow update: if (
        isSignedIn() &&
        isValidOrder(incoming()) &&
        isValidId(orderId) &&
        incoming().orderId == existing().orderId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().orderStatus != 'CANCELLED ❌' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'orderStatus',
              'aiCallStatus',
              'voiceResponse',
              'updatedAt'
            ])
          )
        )
      );
      allow delete: if false;
    }
  }
}
