<!-- Wolko Interactive Product Specifications & Quick View Modal -->
<div id="wolko-product-modal" class="fixed inset-0 z-50 overflow-y-auto hidden" aria-hidden="true" role="dialog" aria-modal="true">
  <div data-close-product-modal class="fixed inset-0 bg-[#24211E]/50 backdrop-blur-xs transition-opacity"></div>

  <div class="relative min-h-screen flex items-center justify-center p-4 sm:p-6">
    <div class="relative w-full max-w-4xl bg-[#FAF8F5] rounded-3xl border border-[#EAE2D8] shadow-2xl overflow-hidden z-10">
      <button
        type="button"
        data-close-product-modal
        class="absolute top-4 right-4 z-20 p-2 rounded-full bg-white/90 hover:bg-white text-[#24211E] shadow-sm border border-[#EAE2D8] transition-transform hover:scale-105"
        aria-label="Close product details"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>

      <div id="wolko-product-modal-body" class="grid grid-cols-1 md:grid-cols-12">
        <!-- Populated dynamically by wolko-theme.js -->
      </div>
    </div>
  </div>
</div>
