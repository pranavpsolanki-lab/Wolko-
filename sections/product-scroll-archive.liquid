<section id="product-scroll" class="relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-[#F5EFEB] border-t border-[#EAE2D8]">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-[#EAE2D8]">
      <div>
        <div class="text-xs uppercase tracking-[0.25em] text-[#8C827A] font-medium mb-2">
          {{ section.settings.kicker }}
        </div>
        <h2 class="font-editorial text-3xl sm:text-5xl font-normal text-[#24211E] tracking-tight">
          {{ section.settings.heading }}
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-[#6B6158] max-w-md font-light">
        Five heirloom signatures from our studio archive — click any piece to inspect full stitch specifications.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
      <!-- Archive Card 01 -->
      <div data-open-product-id="chunky-cloud-tote" class="group cursor-pointer bg-white rounded-2xl border border-[#EAE2D8] overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col">
        <div class="aspect-[4/5] relative overflow-hidden bg-[#FAF8F5]">
          <img src="{{ 'product_chunky_tote_1790489298255.jpg' | asset_url }}" alt="The Wolko Chunky Cloud Tote" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="500" height="625">
          <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded bg-[#FAF8F5]/90 text-[10px] font-mono uppercase text-[#24211E]">01 / Archive</span>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider text-[#8C827A]">Handmade Bags</span>
            <h3 class="font-editorial text-lg text-[#24211E] font-medium mt-0.5 group-hover:text-[#C87D65]">The Wolko Chunky Cloud Tote</h3>
          </div>
          <div class="pt-3 mt-3 border-t border-[#F0EBE4] flex items-center justify-between text-xs font-mono">
            <span class="font-semibold text-[#24211E]">₹3,450</span>
            <span class="text-[#C87D65]">Inspect &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Archive Card 02 -->
      <div data-open-product-id="daisy-botanical-keychain" class="group cursor-pointer bg-white rounded-2xl border border-[#EAE2D8] overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col">
        <div class="aspect-[4/5] relative overflow-hidden bg-[#FAF8F5]">
          <img src="{{ 'product_daisy_charm_1790489314794.jpg' | asset_url }}" alt="Hand-Embroidered Daisy Charm" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="500" height="625">
          <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded bg-[#FAF8F5]/90 text-[10px] font-mono uppercase text-[#24211E]">02 / Archive</span>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider text-[#8C827A]">Keychains &amp; Charms</span>
            <h3 class="font-editorial text-lg text-[#24211E] font-medium mt-0.5 group-hover:text-[#C87D65]">Hand-Embroidered Daisy Charm</h3>
          </div>
          <div class="pt-3 mt-3 border-t border-[#F0EBE4] flex items-center justify-between text-xs font-mono">
            <span class="font-semibold text-[#24211E]">₹790</span>
            <span class="text-[#C87D65]">Inspect &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Archive Card 03 -->
      <div data-open-product-id="heritage-embroidered-pouch" class="group cursor-pointer bg-white rounded-2xl border border-[#EAE2D8] overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col">
        <div class="aspect-[4/5] relative overflow-hidden bg-[#FAF8F5]">
          <img src="{{ 'product_cozy_pouch_1790489355001.jpg' | asset_url }}" alt="Flora Embroidered Wool Pouch" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="500" height="625">
          <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded bg-[#FAF8F5]/90 text-[10px] font-mono uppercase text-[#24211E]">03 / Archive</span>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider text-[#8C827A]">Cozy Pouches</span>
            <h3 class="font-editorial text-lg text-[#24211E] font-medium mt-0.5 group-hover:text-[#C87D65]">Flora Embroidered Wool Pouch</h3>
          </div>
          <div class="pt-3 mt-3 border-t border-[#F0EBE4] flex items-center justify-between text-xs font-mono">
            <span class="font-semibold text-[#24211E]">₹1,850</span>
            <span class="text-[#C87D65]">Inspect &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Archive Card 04 -->
      <div data-open-product-id="slouchy-sage-knit-hobo" class="group cursor-pointer bg-white rounded-2xl border border-[#EAE2D8] overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col">
        <div class="aspect-[4/5] relative overflow-hidden bg-[#FAF8F5]">
          <img src="{{ 'slouchy_hobo_bag_1790504963203.jpg' | asset_url }}" alt="The Oversized Sage Knit Hobo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="500" height="625">
          <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded bg-[#FAF8F5]/90 text-[10px] font-mono uppercase text-[#24211E]">04 / Archive</span>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider text-[#8C827A]">Handmade Bags</span>
            <h3 class="font-editorial text-lg text-[#24211E] font-medium mt-0.5 group-hover:text-[#C87D65]">The Oversized Sage Knit Hobo</h3>
          </div>
          <div class="pt-3 mt-3 border-t border-[#F0EBE4] flex items-center justify-between text-xs font-mono">
            <span class="font-semibold text-[#24211E]">₹3,890</span>
            <span class="text-[#C87D65]">Inspect &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Archive Card 05 -->
      <div data-open-product-id="woolen-twist-mug-cozy" class="group cursor-pointer bg-white rounded-2xl border border-[#EAE2D8] overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col">
        <div class="aspect-[4/5] relative overflow-hidden bg-[#FAF8F5]">
          <img src="{{ 'craft_artisan_hands_1790489331230.jpg' | asset_url }}" alt="Woven Rib Mug Hug & Coaster Duo" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="500" height="625">
          <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded bg-[#FAF8F5]/90 text-[10px] font-mono uppercase text-[#24211E]">05 / Archive</span>
        </div>
        <div class="p-4 flex-1 flex flex-col justify-between">
          <div>
            <span class="text-[10px] uppercase tracking-wider text-[#8C827A]">Everyday Cozy</span>
            <h3 class="font-editorial text-lg text-[#24211E] font-medium mt-0.5 group-hover:text-[#C87D65]">Woven Rib Mug Hug &amp; Coaster Duo</h3>
          </div>
          <div class="pt-3 mt-3 border-t border-[#F0EBE4] flex items-center justify-between text-xs font-mono">
            <span class="font-semibold text-[#24211E]">₹950</span>
            <span class="text-[#C87D65]">Inspect &rarr;</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tactile Archive Scroll",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Tactile Archive"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signature Studio Works"
    }
  ],
  "presets": [
    {
      "name": "Tactile Archive Scroll"
    }
  ]
}
{% endschema %}
