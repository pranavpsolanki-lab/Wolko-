<section class="py-20 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#F5EFEB] border-t border-[#EAE2D8]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="text-xs uppercase tracking-[0.2em] text-[#8C827A] font-medium mb-2">
        {{ section.settings.kicker }}
      </div>
      <h2 class="font-editorial text-3xl sm:text-4xl md:text-5xl font-normal text-[#24211E] tracking-tight mb-4">
        {{ section.settings.heading }}
      </h2>
      <p class="text-sm sm:text-base text-[#6B6158] font-light">
        {{ section.settings.subtext }}
      </p>
    </div>

    <!-- 4 Trust Pillars -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      <div class="bg-white p-6 sm:p-7 rounded-xl border border-[#EAE2D8] flex flex-col justify-between shadow-xs hover:border-[#D9CFC4] transition-all">
        <div>
          <span class="font-mono text-sm font-semibold text-[#C87D65] block mb-2">6+ Hours</span>
          <h3 class="font-editorial text-xl text-[#24211E] font-medium mb-2">100% Human Touch</h3>
          <p class="text-xs text-[#574E45] font-light leading-relaxed">
            Every loop, knot, and seam is guided by skilled artisan hands. No mass factory machinery.
          </p>
        </div>
        <div class="pt-4 mt-6 border-t border-[#F0EBE4] text-[11px] text-[#8C827A]">
          Dedicated per piece
        </div>
      </div>

      <div class="bg-white p-6 sm:p-7 rounded-xl border border-[#EAE2D8] flex flex-col justify-between shadow-xs hover:border-[#D9CFC4] transition-all">
        <div>
          <span class="font-mono text-sm font-semibold text-[#C87D65] block mb-2">100%</span>
          <h3 class="font-editorial text-xl text-[#24211E] font-medium mb-2">Zero Plastic Packaging</h3>
          <p class="text-xs text-[#574E45] font-light leading-relaxed">
            Delivered in biodegradable seeded cotton paper that can be planted in soil to sprout wild herbs.
          </p>
        </div>
        <div class="pt-4 mt-6 border-t border-[#F0EBE4] text-[11px] text-[#8C827A]">
          Compostable packaging
        </div>
      </div>

      <div class="bg-white p-6 sm:p-7 rounded-xl border border-[#EAE2D8] flex flex-col justify-between shadow-xs hover:border-[#D9CFC4] transition-all">
        <div>
          <span class="font-mono text-sm font-semibold text-[#C87D65] block mb-2">25 Pcs</span>
          <h3 class="font-editorial text-xl text-[#24211E] font-medium mb-2">Small Batch &amp; Slow Made</h3>
          <p class="text-xs text-[#574E45] font-light leading-relaxed">
            We produce in mindful limited quantities of 20–30 pieces to eliminate excess waste.
          </p>
        </div>
        <div class="pt-4 mt-6 border-t border-[#F0EBE4] text-[11px] text-[#8C827A]">
          Average batch limit
        </div>
      </div>

      <div class="bg-white p-6 sm:p-7 rounded-xl border border-[#EAE2D8] flex flex-col justify-between shadow-xs hover:border-[#D9CFC4] transition-all">
        <div>
          <span class="font-mono text-sm font-semibold text-[#C87D65] block mb-2">Fair Trade</span>
          <h3 class="font-editorial text-xl text-[#24211E] font-medium mb-2">Direct from Makers</h3>
          <p class="text-xs text-[#574E45] font-light leading-relaxed">
            Fair, transparent compensation supporting independent women artisans across India.
          </p>
        </div>
        <div class="pt-4 mt-6 border-t border-[#F0EBE4] text-[11px] text-[#8C827A]">
          Empowered artisan network
        </div>
      </div>
    </div>

    <!-- Studio Transparency Banner -->
    <div class="bg-white rounded-2xl border border-[#EAE2D8] p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xs">
      <div class="flex items-center gap-4 text-left">
        <div class="w-12 h-12 rounded-full bg-[#FAF8F5] border border-[#EAE2D8] flex items-center justify-center shrink-0 text-[#24211E] text-lg">
          🌱
        </div>
        <div>
          <h4 class="font-editorial text-lg text-[#24211E] font-semibold">
            Plastic-Free Seeded Packaging
          </h4>
          <p class="text-xs text-[#6B6158] font-light">
            Our plantable seed paper tags grow into marigolds or herbs when placed in wet soil.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-6 text-xs text-[#4A443E] font-medium shrink-0">
        <div class="flex items-center gap-1.5">
          <span class="text-[#7B8A78]">✓</span>
          <span>Safe UPI / Card Checkout</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-[#7B8A78]">↻</span>
          <span>7-Day Return Window</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust & Transparency",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pledge & Transparency"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made with Care. Chosen with Intention."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtitle",
      "default": "Every order is treated like a personal gift from our studio to your doorstep."
    }
  ],
  "presets": [
    {
      "name": "Trust & Transparency"
    }
  ]
}
{% endschema %}
