<section class="py-24 sm:py-32 px-4 sm:px-6 lg:px-8 bg-[#FAF8F5] text-center">
  <div class="max-w-xl mx-auto">
    <span class="font-mono text-xs uppercase tracking-widest text-[#C87D65] block mb-3">404 &middot; Atelier Archive</span>
    <h1 class="font-editorial text-4xl sm:text-6xl text-[#24211E] font-normal mb-4">
      {{ 'templates.404.title' | t }}
    </h1>
    <p class="text-sm sm:text-base text-[#6B6158] font-light mb-8">
      {{ 'templates.404.subtext' | t }}
    </p>
    <a
      href="{{ routes.root_url }}"
      class="inline-block px-8 py-3.5 bg-[#24211E] hover:bg-[#3A3530] text-[#FAF8F5] text-xs uppercase tracking-widest font-semibold rounded-full transition-colors"
    >
      Return to Wolko Studio
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
