<!doctype html>
<html class="no-js scroll-smooth" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background | default: '#FAF8F5' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/jpeg" href="{{ 'wolko_logo_1790489253517.jpg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name | default: 'Wolko | Handcrafted Wool & Artisan Lifestyle' }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="{{ settings.brand_description | default: 'Premium handcrafted wool products, keychains, cozy accessories, and slow-made artisan lifestyle goods crafted with warmth, patience, and care.' | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <!-- Editorial Display & Body Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Shopify Required Header Content -->
    {{ content_for_header }}

    <style>
      :root {
        --background: {{ settings.color_background | default: '#FAF8F5' }};
        --foreground: {{ settings.color_text | default: '#24211E' }};
        --font-serif: 'Cormorant Garamond', Georgia, serif;
        --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --color-ivory: {{ settings.color_background | default: '#FAF8F5' }};
        --color-cream: {{ settings.color_secondary_bg | default: '#F5EFEB' }};
        --color-oat: #EAE2D8;
        --color-taupe: #8C827A;
        --color-charcoal: {{ settings.color_text | default: '#24211E' }};
        --color-sage: {{ settings.color_sage | default: '#7B8A78' }};
        --color-terracotta: {{ settings.color_accent | default: '#C87D65' }};
        --color-blush: #E8B4B8;
        --color-lavender: #C4B5D4;
        --color-dustyblue: #93A8B8;
      }
      body {
        font-family: var(--font-sans);
        background-color: var(--color-ivory);
        color: var(--color-charcoal);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      h1, h2, h3, .font-editorial {
        font-family: var(--font-serif);
      }
    </style>

    {{ 'wolko-theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.WolkoShopify = {
        shopName: {{ shop.name | default: 'Wolko' | json }},
        currency: {{ cart.currency.iso_code | default: 'INR' | json }},
        currencySymbol: {{ cart.currency.symbol | default: '₹' | json }},
        moneyFormat: {{ shop.money_format | default: '₹{{amount}}' | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 1999 | times: 100 }},
        whatsappPrimary: {{ settings.whatsapp_primary | default: '918237323043' | json }},
        whatsappBackup: {{ settings.whatsapp_backup | default: '918591542015' | json }},
        routes: {
          root_url: '{{ routes.root_url }}',
          cart_url: '{{ routes.cart_url }}',
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_change_url: '{{ routes.cart_change_url }}',
          cart_update_url: '{{ routes.cart_update_url }}',
          search_url: '{{ routes.search_url }}',
          predictive_search_url: '{{ routes.predictive_search_url }}'
        }
      };
    </script>
  </head>

  <body class="template-{{ template.name | handle }} relative min-h-screen bg-[#FAF8F5] text-[#24211E] antialiased selection:bg-[#E2D2C3] selection:text-[#24211E]">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#24211E] focus:text-white focus:rounded-full" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Interactive Drawers, Modals & Floating Actions -->
    {% render 'cart-drawer' %}
    {% render 'search-modal' %}
    {% render 'wishlist-drawer' %}
    {% render 'product-quickview-modal' %}
    {% render 'whatsapp-float' %}
    {% render 'wolko-catalog-data' %}

    <script src="{{ 'wolko-theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
